# GrokCall Environment Configuration

# Server
APP_ENV=development
DEBUG=false
PORT=8000
HOST=0.0.0.0
BASE_URL=https://phone.example.com

# MCP Security (Streamable HTTP Bearer Token)
MCP_BEARER_TOKEN=change-this-to-a-secure-random-token

# 46elks Telephony Credentials & Numbers
FORTYSIX_ELKS_API_USERNAME=u...
FORTYSIX_ELKS_API_PASSWORD=p...
FORTYSIX_ELKS_REALTIME_NUMBER=+46766860000
# Optional custom audio file URL played before connecting:
# FORTYSIX_ELKS_CONNECTING_AUDIO_URL=https://phone.example.com/static/connecting.mp3

# ElevenLabs Speech-to-Text & Text-to-Speech
ELEVENLABS_API_KEY=xi_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Slack Wake Channel Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../X...

# Persona & Fallback Timeouts (seconds)
ASSISTANT_OWNER_NAME=Patrik
DEFAULT_LANGUAGE=sv
GROK_WAKE_TIMEOUT_SECONDS=6.0
FALLBACK_TIMEOUT_SECONDS=12.0

# Persistence
SQLITE_DB_PATH=grokcall.db

# Cloudflare Tunnel (if running with docker-compose)
CLOUDFLARE_TUNNEL_TOKEN=ey...
