# GrokCall gateway configuration.
# Every variable maps to a field in grokcall/core/config.py (same name, lower-cased).

# --- Server -------------------------------------------------------------------
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
# Public origin served by the Cloudflare tunnel.
BASE_URL=https://phone.example.com

# --- Security -----------------------------------------------------------------
# Bearer token the Grok Bot presents on /mcp. Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=change-me
# Long random path segment for the realtime WebSocket. When set, 46elks must be
# pointed at wss://phone.example.com/46elks/realtime/<token>. Generate as above.
REALTIME_PATH_TOKEN=change-me-too

# --- 46elks -------------------------------------------------------------------
FORTYSIXELKS_API_USERNAME=u...
FORTYSIXELKS_API_PASSWORD=p...
# The WebSocket-enabled number the voice number connects the caller to (required).
FORTYSIXELKS_REALTIME_NUMBER=+46766860000
# Optional short clip played while the realtime leg is bridged. Drop a file in
# projects/grokcall/assets/ and it is served under /static/. If unset, the gateway
# speaks the connecting sentence via TTS as soon as the leg is up.
# CONNECTING_AUDIO_URL=https://phone.example.com/static/connecting.mp3

# --- ElevenLabs ---------------------------------------------------------------
ELEVENLABS_API_KEY=xi-...
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_STT_MODEL_ID=scribe_v2_realtime
# Leave unset for automatic language detection (sv/en switching per utterance).
# ELEVENLABS_STT_LANGUAGE=sv
# ELEVENLABS_STT_SECONDARY_LANGUAGES=en
ELEVENLABS_STT_VAD_SILENCE_SECS=0.7

# --- Slack wake signal --------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../X...

# --- Persona ------------------------------------------------------------------
ASSISTANT_OWNER_NAME=Patrik
DEFAULT_LANGUAGE=sv

# --- Timeouts (seconds) -------------------------------------------------------
GROK_HOLD_TIMEOUT_SECONDS=6
GROK_FALLBACK_TIMEOUT_SECONDS=12
UTTERANCE_POLL_MAX_SECONDS=25
PENDING_CALL_EXPIRY_SECONDS=120
ENDED_CALL_RETENTION_SECONDS=3600

# --- Persistence --------------------------------------------------------------
SQLITE_DB_PATH=/app/data/grokcall.db

# --- Cloudflare tunnel (docker-compose only) ----------------------------------
CLOUDFLARE_TUNNEL_TOKEN=ey...
